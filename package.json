{
  "name": "custom-gifs-slack-command",
  "version": "0.1.0",
  "private": true,
  "description": "Search for and post custom gifs in Slack",
  "license": "GPL",
  "author": "Pez Cuckow",
  "main": "index.js",
  "scripts": {
    "format:write": "yarn run format:write:js && prettier --write .",
    "format:write:js": "eslint --fix .",
    "lint": "yarn run lint:js && prettier --check .",
    "lint:js": "eslint .",
    "prepare": "husky install",
    "start": "node app.js",
    "start:dev": "nodemon app.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "*.js": "eslint --cache --fix",
    "package.json": "sort-package-json"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "body-parser": "^2.3.0",
    "debug-level": "^4.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fuse.js": "^7.4.2",
    "glob": "^13.0.6",
    "glob-promise": "^6.0.7",
    "morgan": "^1.11.0",
    "node-cache": "^5.1.2",
    "pg": "^8.21.0",
    "tsscmp": "^1.0.6",
    "weighted-random": "^0.1.0"
  },
  "devDependencies": {
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "sort-package-json": "^4.0.0"
  },
  "engines": {
    "node": "^16.18.0",
    "yarn": "^1.22.10"
  },
  "volta": {
    "node": "16.18.0"
  },
  "authors": [
    "Pez Cuckow <email@pezcuckow.com>"
  ]
}
